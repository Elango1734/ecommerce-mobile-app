# dependencies
node_modules/

# Xcode build artifacts (ios/ and android/ themselves are tracked — bare RN, not CNG-generated)
ios/build/
ios/Pods/
ios/*.xcuserstate
ios/**/*.xcuserdata
ios/**/xcuserdata
ios/DerivedData/
ios/**/*.hmap
ios/**/*.ipa
ios/**/.xcode.env.local

# Android build artifacts
android/app/build/
android/build/
android/.gradle/
android/.idea/
android/local.properties
android/*.iml
android/*.hprof
android/**/.cxx/
android/**/*.keystore
!android/app/debug.keystore
.kotlin/

# Expo leftovers (migrated to bare RN CLI; this is local tooling state)
.expo/
expo-env.d.ts

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# testing
coverage/
